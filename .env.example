# Exemplo de variáveis de ambiente do Mensageiro (BRIEFING §15, RAILWAY §8).
# Copie para .env e preencha. NUNCA versionar o .env real nem colar segredos aqui.

# --- Banco ---
DATABASE_URL=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
# Confirmar a versão atual na documentação oficial da Meta antes de usar (BRIEFING §10.1).
GRAPH_API_VERSION=
# Números de admin autorizados a dar comandos pelo WhatsApp, separados por vírgula (E.164).
ADMIN_WHATSAPP_NUMBERS=

# --- IA (OpenAI) ---
OPENAI_API_KEY=
# Padrão do projeto; NUNCA usar gpt-4o-mini (desligado em 14/01/2027) — BRIEFING §2.
OPENAI_MODEL=gpt-6-luna

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_ALERTAS=

# --- URLs ---
FRONTEND_URL=
API_URL=

# --- Observabilidade ---
SENTRY_DSN=

# --- Web Push (PWA) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Fuso ---
TZ=America/Sao_Paulo

# --- Primeiro acesso (remover após criar o admin) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
